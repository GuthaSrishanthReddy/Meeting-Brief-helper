# Copy this file to .env and put your key(s) in. .env is git-ignored.
# The Gemini key is used if present; otherwise the OpenAI key is used; with neither, the
# program runs on code only.
GEMINI_API_KEY="key_goes_here"
OPENAI_KEY="key_goes_here"

# Optional
# R3_MODEL=gemini-3.5-flash-lite
# R3_OPENAI_MODEL=gpt-6-luna
# R3_PROVIDER=openai
# R3_NO_LLM=1
